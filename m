A review is first -- it looks good and useful, just a few small issues:


+static spinlock_t cpufreq_stats_lock =3D SPIN_LOCK_UNLOCKED;

Please use spin_lock_init(&cpufreq_stats_lock) in cpufreq_stats_init()
instead of SPIN_LOCK_UNLOCKED, please. It's something which helps for
the
"real-time" patches currently under discussion.

+#define CPUFREQ_STATDEVICE_ATTR(_name,_mode,_show) \
+static struct cpufreq_stats_attribute _attr_##_name =3D {\
+	.attr =3D {.name =3D __stringify(_name), .mode =3D _mode, }, \

AFAICS a ".owner =3D THIS_MODULE" is missing inside .attr

+	struct kobject kobj;

Do we need a kobject for this? Could a atrribute_group suffice?

+cpufreq_stats_attr_show(struct kobject * kobj,
+		struct attribute *attr, char *buf)
+{
+	struct cpufreq_stats_attribute *cpufreq_stat_attr
+		=3D (struct cpufreq_stats_attribute *)(attr);
+	struct cpufreq_stats *stat =3D (struct cpufreq_stats *)kobj;

This looks like a hack. Please use "container_of(,,)" instead, possibly
in a
#define -- like
#define to_pci_bus(n)   container_of(n, struct pci_bus, class_dev)

+static struct kobj_type ktype_cpufreq_stats =3D {
+	.sysfs_ops =3D &cpufreq_stats_attr_ops,
+	.default_attrs =3D default_attrs
+};
+
...
+	for (i =3D 0;(attr =3D stat_attrs[i]); i++) {
+		if ((ret =3D sysfs_create_file(&stat->kobj, &attr->attr)))
+			goto error_out_unregister;
+	}

You can remove this loop (and stat_attrs[]) if you do:

static struct attribute *default_attrs[] =3D {
	&_attr_total_trans.attr,
