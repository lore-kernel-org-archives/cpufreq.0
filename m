# This is a BitKeeper generated diff -Nru style patch.
#
# ChangeSet
#   2004/09/23 14:08:30+09:00 miura@da-cha.org 
#   [CPUFreq] speedstep-centrino: handle cpu p-state properly when resume. 
#   
#   Signed-off-by: Hiroshi Miura <miura@da-cha.org>
# 
# arch/i386/kernel/cpu/cpufreq/speedstep-centrino.c
#   2004/09/23 14:08:19+09:00 miura@da-cha.org +15 -0
#   [CPUFreq] speedstep-centrino: handle cpu p-state properly when resume. 
# 
diff -Nru a/arch/i386/kernel/cpu/cpufreq/speedstep-centrino.c b/arch/i386/kernel/cpu/cpufreq/speedstep-centrino.c
--- a/arch/i386/kernel/cpu/cpufreq/speedstep-centrino.c	2004-09-23 14:15:54 +09:00
+++ b/arch/i386/kernel/cpu/cpufreq/speedstep-centrino.c	2004-09-23 14:15:54 +09:00
@@ -386,6 +386,20 @@
 static inline int centrino_cpu_init_acpi(struct cpufreq_policy *policy) { return -ENODEV; }
 #endif
 
+static int centrino_resume(struct cpufreq_policy *policy)
+{
+	unsigned long cur_freq;
+	int i;
+
+	cur_freq = get_cur_freq(0);
+
+        for (i=0; i<p.state_count; i++) {
+                if (cur_freq == centrino_model->op_points[i].frequency)
+			p.state = i;
+	}
+	return 0;
+}
+
 static int centrino_cpu_init(struct cpufreq_policy *policy)
 {
 	struct cpuinfo_x86 *cpu = &cpu_data[policy->cpu];
@@ -553,6 +567,7 @@
 	.exit		= centrino_cpu_exit,
 	.verify 	= centrino_verify,
 	.target 	= centrino_target,
+	.resume		= centrino_resume,
 	.get		= get_cur_freq,
 	.attr           = centrino_attr,
 	.owner		= THIS_MODULE,

