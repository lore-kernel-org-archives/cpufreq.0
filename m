Hi Thaly,

This is new patch. please try it.
It may pass the CPU check on your ZFx86 based SBC.

At Fri, 26 Mar 2004 13:17:54 +0900,
Hiroshi Miura wrote:
> 
> Hi Thaly,
> 
> I'm sorry I just now knows that the 2.6 kernel cannot properly detect
> a Cx486DX2 as Cyrix CPU. only 486.
> So, driver's check routine decide it is not Cyrix, then cannot use.


--Multipart_Wed_Mar_31_01:10:40_2004-1
Content-Type: application/octet-stream; type=patch
Content-Disposition: attachment; filename="ZFx86-rev2.patch"
Content-Transfer-Encoding: 7bit

# This is a BitKeeper generated patch for the following project:
# Project Name: Linux kernel tree
# This patch format is intended for GNU patch command version 2.5 or higher.
# This patch includes the following deltas:
#	           ChangeSet	1.1670  -> 1.1672 
#	include/linux/pci_ids.h	1.142   -> 1.143  
#	arch/i386/kernel/cpu/cpufreq/gx-suspmod.c	1.11    -> 1.14   
#
# The following is the BitKeeper ChangeSet Log
# --------------------------------------------
# 04/03/25	miura@da-cha.org	1.1608.106.1
# Support ZFMicro ZFx86.
# --------------------------------------------
# 04/03/25	miura@da-cha.org	1.1608.106.2
# Fix PCI ID which is on ZFx86 Sysytem which used on CPUFreq driver.
# --Hiroshi Miura
# --------------------------------------------
# 04/03/25	miura@da-cha.org	1.1671
# Merge bk://linux.bkbits.net/linux-2.5
# into da-cha.org:/home/miura/kernel/linux-2.6-bk-hm
# --------------------------------------------
# 04/03/31	miura@da-cha.org	1.1672
# Fix up on ZFx86 platform.
# --------------------------------------------
#
diff -Nru a/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c b/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c
--- a/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c	Wed Mar 31 01:08:51 2004
+++ b/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c	Wed Mar 31 01:08:51 2004
@@ -52,6 +52,13 @@
  *---------------------------------------------------------------------------
  *
  * ChangeLog:
+ * 	Mar. 27, 2004	Hiroshi Miura <miurahr@intellilink.co.jp>
+ * 		- pass 486 CPUs when check vendorid which ZFx86 detect
+ * 		  as UNKNOWN-486.
+ *
+ * 	Mar. 24, 2004	Hiroshi Miura <miurahr@intellilink.co.jp>
+ * 		- add support for ZFMicro's ZFx86.
+ *
  *  	Dec. 12, 2003	Hiroshi Miura <miura@da-cha.org>
  *  		- fix on/off register mistake
  *  		- fix cpu_khz calc when it stops cpu modulation.
@@ -66,7 +73,7 @@
  *---------------------------------------------------------------------------
  *
  * Todo
- *	Test on machines with 5510, 5530, 5530A
+ *	Test on machines with 5510, 5530, 5530A, ZFx86
  */
 
 /************************************************************************
@@ -181,6 +188,7 @@
         { PCI_VENDOR_ID_CYRIX, PCI_DEVICE_ID_CYRIX_5530_LEGACY, PCI_ANY_ID, PCI_ANY_ID },
         { PCI_VENDOR_ID_CYRIX, PCI_DEVICE_ID_CYRIX_5520, PCI_ANY_ID, PCI_ANY_ID },
         { PCI_VENDOR_ID_CYRIX, PCI_DEVICE_ID_CYRIX_5510, PCI_ANY_ID, PCI_ANY_ID },
+	{ PCI_VENDOR_ID_CYRIX, PCI_DEVICE_ID_CYRIX_ZFX86_LIO, PCI_ANY_ID, PCI_ANY_ID },
         { 0, },
 };
 
@@ -194,9 +202,10 @@
 
 	/* check if CPU is a MediaGX or a Geode. */
         if ((current_cpu_data.x86_vendor != X86_VENDOR_NSC) && 
-	    (current_cpu_data.x86_vendor != X86_VENDOR_CYRIX)) {
-		printk(KERN_INFO "gx-suspmod: error: no MediaGX/Geode processor found!\n");
-		return NULL;		
+	    (current_cpu_data.x86_vendor != X86_VENDOR_CYRIX) &&
+	    (current_cpu_data.x86 != 4) {
+		printk(KERN_INFO "gx-suspmod: error: there is not MediaGX/Geode/ZFx86 processor!\n");
+		return NULL;
 	}
 
 	/* detect which companion chip is used */
@@ -295,9 +304,17 @@
 				suscfg = gx_params->pci_suscfg | SUSMOD | PWRSVE;
 			}
 			break;
+		case PCI_DEVICE_ID_CYRIX_ZFX86_LIO:
+			pmer1 = gx_params->pci_pmer1 | IRQ_SPDUP;
+			/* FIXME: need to test other values -- Miura */
+			pci_write_config_byte(gx_params->cs55x0, PCI_IRQTC, 4); /* typical 2 to 4ms */
+			pci_write_config_byte(gx_params->cs55x0, PCI_PMER1, pmer1);
+			suscfg = gx_params->pci_suscfg | SUSMOD;
+			break;
 		case PCI_DEVICE_ID_CYRIX_5520:
 		case PCI_DEVICE_ID_CYRIX_5510:
 			suscfg = gx_params->pci_suscfg | SUSMOD;
+			break;
 		default:
 			local_irq_restore(flags);
 			dprintk("fatal: try to set unknown chipset.\n");
diff -Nru a/include/linux/pci_ids.h b/include/linux/pci_ids.h
--- a/include/linux/pci_ids.h	Wed Mar 31 01:08:51 2004
+++ b/include/linux/pci_ids.h	Wed Mar 31 01:08:51 2004
@@ -367,6 +367,7 @@
 #define PCI_DEVICE_ID_NS_87560_USB	0x0012
 #define PCI_DEVICE_ID_NS_83815		0x0020
 #define PCI_DEVICE_ID_NS_83820		0x0022
+#define PCI_DEVICE_ID_NS_ZFX86_BRIDGE   0x0023
 #define PCI_DEVICE_ID_NS_SCx200_BRIDGE	0x0500
 #define PCI_DEVICE_ID_NS_SCx200_SMI	0x0501
 #define PCI_DEVICE_ID_NS_SCx200_IDE	0x0502
@@ -854,6 +855,10 @@
 #define PCI_DEVICE_ID_CYRIX_5530_IDE	0x0102
 #define PCI_DEVICE_ID_CYRIX_5530_AUDIO	0x0103
 #define PCI_DEVICE_ID_CYRIX_5530_VIDEO	0x0104
+#define PCI_DEVICE_ID_CYRIX_ZFX86_LIO   0x0400
+#define PCI_DEVICE_ID_CYRIX_ZFX86_SMI   0x0401
+#define PCI_DEVICE_ID_CYRIX_ZFX86_IDE   0x0402
+#define PCI_DEVICE_ID_CYRIX_ZFX86_XBUS  0x0403
 
 #define PCI_VENDOR_ID_LEADTEK		0x107d
 #define PCI_DEVICE_ID_LEADTEK_805	0x0000

