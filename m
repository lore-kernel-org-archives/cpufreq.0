#### COMMENT END

# This is a BitKeeper generated diff -Nru style patch.
#
# ChangeSet
#   2005/01/03 16:23:37+09:00 miura@da-cha.org 
#   To fix to return a proper cpu speed on gx-suspmod CPUFreq driver.
#   
#   Signed-Off-by: Hiroshi Miura <miura@da-cha.org>
# 
# arch/i386/kernel/cpu/cpufreq/gx-suspmod.c
#   2005/01/03 16:23:26+09:00 miura@da-cha.org +1 -1
#   fix to return a proper cpu speed. it is caused by mistaking on and off meaning.
# 
diff -Nru a/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c b/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c
--- a/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c	2005-01-03 16:25:46 +09:00
+++ b/arch/i386/kernel/cpu/cpufreq/gx-suspmod.c	2005-01-03 16:25:46 +09:00
@@ -219,7 +219,7 @@
 	if ((gx_params->pci_suscfg & SUSMOD) == 0) 
 		return stock_freq;
 
-	return (stock_freq * gx_params->on_duration) 
+	return (stock_freq * gx_params->off_duration) 
 		/ (gx_params->on_duration + gx_params->off_duration);
 }
 

